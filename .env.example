# ─── App ───
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Public origin(s) of the live site — used for the CORS allowlist.
# Comma-separated so apex and www can both be permitted.
APP_URL=https://accagurukul.com,https://www.accagurukul.com

# ─── Database (MySQL / phpMyAdmin) ───
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=acca_db
DB_USERNAME=root
DB_PASSWORD=
