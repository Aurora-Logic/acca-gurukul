DirectoryIndex index.php index.html

RewriteEngine On
RewriteBase /

# ==========================================
# 0. CANONICAL HOST & SCHEME
# ==========================================
# Every page must be reachable at exactly one URL. Without these, the same
# content answers on http/https and www/non-www, which splits ranking signals
# across up to four duplicate addresses.
#
# Enable once HTTPS is live on the domain (leave commented on local/staging):
#
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://accagurukul.com/$1 [R=301,L]
#
# RewriteCond %{HTTP_HOST} ^www\.accagurukul\.com$ [NC]
# RewriteRule ^(.*)$ https://accagurukul.com/$1 [R=301,L]

# Homepage moved from /home/ to the site root. Permanent so the ranking
# signals that /home/ accumulated transfer to "/".
RewriteRule ^home/?$ / [R=301,L]

# /index.php is the same page as "/" — collapse it.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Dynamic robots.txt and sitemap.xml (both read from the database).
RewriteRule ^robots\.txt$ robots.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ==========================================
# 1. SECURITY RULES (File Hijacking Prevention)
# ==========================================

# Prevent directory listing
Options -Indexes

# Block access to all hidden files and directories (starting with a dot, e.g., .env, .git, .htaccess)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Specifically reject RewriteRule traversal tricks (e.g. /home/../.env)
RewriteRule "(^|/)\." - [F]

# Block access to sensitive development, lock, configuration files, and database dumps
<FilesMatch "^(package\.json|package-lock\.json|composer\.json|composer-lock\.json|tsconfig\.json|components\.json|Doxyfile|yarn\.lock|pnpm-lock\.yaml|.*\.sql)$">
    Require all denied
</FilesMatch>

# Prevent access to source files inside the admin folder
<FilesMatch "^(eslint\.config\.js|vite\.config\.ts|tsconfig\.app\.json|tsconfig\.node\.json|tsconfig\.tsbuildinfo)$">
    Require all denied
</FilesMatch>

# Uploaded files are user-supplied bytes and must never execute. The rules for
# that live in uploads/.htaccess — <Directory> is only valid in server config,
# not here, and using it would 500 the entire site.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # The admin panel and the API must never be cached by a shared proxy.
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ==========================================
# 2. ADMIN PANEL (React SPA Routing)
# ==========================================

# Rewrite /admin, /admin/, or /admin/index.html directly to the built admin panel index
RewriteRule ^admin/?(index\.html)?$ admin/dist/index.html [L]

# Rewrite all other /admin/... routes (React SPA router paths) to the admin index,
# unless they are real files or directories (e.g., admin/dist/assets/...)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/(.*)$ admin/dist/index.html [L]

# ==========================================
# 3. FALLBACK ASSETS MAPPING FOR ADMIN
# ==========================================

# Map requests to /assets/ or /images/ to admin/dist/ if they do not exist in the root
# (This ensures React absolute-path assets load correctly without breaking main site assets)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/(.*)$ admin/dist/assets/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^images/(.*)$ admin/dist/images/$1 [L]

# ==========================================
# 4. CLEAN URL ROUTING (Main Site)
# ==========================================

# Clean URL routing for single blog posts
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blogs/([^/]+)/?$ blogs/index.php?slug=$1 [L,QSA]

# Public pages are directories containing index.php, so /about-us and
# /about-us/ must resolve to the same place. Redirect the bare form to the
# trailing-slash form rather than serving both.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(/$|\.)
RewriteRule ^(.*)$ /$1/ [R=301,L]

# Append .html/.php to clean URLs if a matching file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ==========================================
# 5. PERFORMANCE (Core Web Vitals)
# ==========================================
# Page speed is a ranking signal, and slow LCP is the most common reason an
# otherwise healthy page underperforms.

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    # Fingerprinted/versioned assets — safe to cache hard.
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"

    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/pdf           "access plus 1 month"

    # HTML must stay fresh so content edits appear immediately.
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>
